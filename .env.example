# Copia este archivo como .env.local y rellena los valores de tu proyecto Firebase
# (Consola de Firebase → Configuración del proyecto → Tus apps → App web → Configuración).
# Si lo dejas vacío, la app arranca en modo demo (datos solo en este navegador).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Clave pública VAPID para las notificaciones push (cd notifier && npm run vapid)
VITE_VAPID_PUBLIC_KEY=
