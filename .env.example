# Copy this file to .env.local and fill in your Firebase project's values
# (Firebase console → Project settings → Your apps → Web app → Config).
# If left empty, the app starts in demo mode (data stored only in this browser).
VITE_FIREBASE_API_KEY=
# Use YOUR-PROJECT.web.app (not firebaseapp.com) so Google sign-in works in the iPhone app
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# VAPID public key for push notifications (npm --prefix functions run vapid)
VITE_VAPID_PUBLIC_KEY=
