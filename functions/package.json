    "vapid": "tsx src/vapid.ts"
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/web-push": "^3.6.4",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
